# Build options
BUILD_USER="ubuntu"
# Public Atuin service; override to point at a self-hosted server.
ATUIN_SERVER="https://api.atuin.sh"
ATUIN_VERSION="18.19.0"
GITHUB_TOKEN=""

# TZ
TZone="America/Los_Angeles"

# Docker config
IMAGE_PUSH="false"
IMAGE_SERVICE="docker"
IMAGE_NAME="goliath"
IMAGE_REPO="goliath"

# Host settings for docker-run.sh and compose.yaml
SSH_PORT="2222"
CODE_SERVER_PORT="8443"
DOCKER_GID="" # compose.yaml only, stat -c %g /var/run/docker.sock

# AWS Config
AWS_REGION=""
AWS_HOST=""

# Docker Hub Config
DOCKER_USER=""
DOCKER_EMAIL=""
