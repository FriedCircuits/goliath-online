# Build options
BUILD_USER="ubuntu"
# Public Atuin service; override to point at a self-hosted server.
ATUIN_SERVER="https://api.atuin.sh"
ATUIN_VERSION="18.19.0"
GITHUB_TOKEN=""

# TZ
TZone="America/Los_Angeles"

# Docker config
IMAGE_PUSH="false"
IMAGE_SERVICE="docker"
IMAGE_NAME="goliath"
IMAGE_REPO="goliath"

# AWS Config
AWS_REGION=""
AWS_HOST=""

# Docker Hub Config
DOCKER_USER=""
DOCKER_EMAIL=""
