{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Pin GitHub Actions to a commit SHA and review them together.",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "groupName": "github actions"
    },
    {
      "description": "Routine GitHub Actions updates only change CI, so merge them once the build passes. Majors stay a reviewed PR.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "pinDigest records the SHA of a tag already in use, so the release cooldown does not apply.",
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Only move the base image between LTS releases.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "/^\\d[02468]\\.04$/"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with a `# renovate: datasource=... depName=...` comment on the line above.",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)build\\.cfg\\.example$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n[^\\n]*?_VERSION=\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "rebaseWhen": "conflicted",
  "separateMultipleMajor": true
}
