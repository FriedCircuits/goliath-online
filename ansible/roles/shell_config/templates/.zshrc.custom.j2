# Fix Bindkey Home/End
bindkey "\e[1~" beginning-of-line
bindkey  "\e[4~" end-of-line

{% if install.brew %}
export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
{% endif %}

export PATH="$HOME/.bin:$PATH"
{% if install.claude_code %}
export PATH="$HOME/.local/bin:$PATH"
{% if not claude_code.auto_update %}
export DISABLE_AUTOUPDATER=1
{% endif %}
{% endif %}
# Needed for vscode remote-ssh gpg
export GPG_TTY=$(tty)

{% if install.atuin %}
{% if atuin.db_on_tmpfs %}
# Atuin keeps its SQLite on tmpfs (see ~/.config/atuin/config.toml). tmpfs is
# cleared when the container restarts, so recreate the directory before atuin
# initialises. History is restored by `atuin sync`.
[ -d /dev/shm/atuin ] || mkdir -p -m 700 /dev/shm/atuin
{% endif %}
eval "$(atuin init zsh)"
{% endif %}


{% if install.terraform %}
alias tfs="tfswitch -b $HOME/.bin/terraform"
{% endif %}

{% if install.terraform and install.gruntwork %}
alias tg="terragrunt"
alias tgp="terragrunt plan"
alias tga="terragrunt apply"
alias tgd="terragrunt destroy"
alias tgi="terragrunt import"
alias tgI="terragrunt init"
alias tgS="terragrunt state"
alias tgs="terragrunt show"
alias tgv="terragrunt validate"
{% endif %}

{% if install.uv %}
export UV_PYTHON_DOWNLOADS={{ uv.python_downloads }}
{% endif %}
{% if install.fnm %}
eval "$(fnm env --use-on-cd --shell zsh)"
{% endif %}
{% if install.direnv %}
eval "$(direnv hook zsh)"
{% endif %}
