#!/command/with-contenv bash
# Runs once at startup, before the services start.
set -eu

{% if install.ssh_server %}
# Keep the SSH host keys in the home volume so a rebuilt image keeps the
# same fingerprint. The first start generates them.
HOST_KEYS=/home/{{ user }}/.local/share/goliath/ssh
if ls "$HOST_KEYS"/ssh_host_*_key > /dev/null 2>&1; then
  sudo cp "$HOST_KEYS"/ssh_host_* /etc/ssh/
  sudo chown root:root /etc/ssh/ssh_host_*
  sudo chmod 600 /etc/ssh/ssh_host_*_key
  sudo chmod 644 /etc/ssh/ssh_host_*_key.pub
else
  sudo ssh-keygen -A > /dev/null
  mkdir -p "$HOST_KEYS"
  chmod 700 "$HOST_KEYS"
  sudo cp /etc/ssh/ssh_host_* "$HOST_KEYS"/
  sudo chown "$(id -u):$(id -g)" "$HOST_KEYS"/ssh_host_*
fi
{% endif %}

{% if install.claude_code %}
# Nothing runs yet, so these records are left from an earlier container.
# Claude Code takes them for open chats and resumes those as copies.
rm -f "${CLAUDE_CONFIG_DIR:-/home/{{ user }}/.claude}"/sessions/*.json "${CLAUDE_CONFIG_DIR:-/home/{{ user }}/.claude}"/sessions/*.key
{% endif %}

# Tools used to be installed into ~/.bin, where the home volume kept stale
# copies that hid newer ones in /usr/local/bin. Remove those once.
if [ ! -e /home/{{ user }}/.bin/.goliath-cleaned ]; then
  for f in sops age age-keygen terragrunt tfswitch codex atuin claude-rc CHANGELOG.md completions; do
    if [ -e "/home/{{ user }}/.bin/$f" ]; then
      rm -rf "/home/{{ user }}/.bin/$f" && echo "Removed old ~/.bin/$f"
    fi
  done
  mkdir -p /home/{{ user }}/.bin && touch /home/{{ user }}/.bin/.goliath-cleaned
fi

# ~/.zshrc.custom used to hold the image's shell settings, which now live in
# /etc/goliath/zshrc. Move an old copy aside once.
ZSHRC_CUSTOM=/home/{{ user }}/.zshrc.custom
if [ -f "$ZSHRC_CUSTOM" ] && ! grep -q /etc/goliath/zshrc "$ZSHRC_CUSTOM"; then
  mv "$ZSHRC_CUSTOM" "$ZSHRC_CUSTOM.bak"
  printf '# Image settings, updated with each rebuild.\nsource /etc/goliath/zshrc\n\n# Your own settings below.\n' > "$ZSHRC_CUSTOM"
  echo "Moved old ~/.zshrc.custom to ~/.zshrc.custom.bak"
fi

{% if install.docker_cli %}
# Match the docker group to the host socket so SSH logins can use it.
# Skip root owned sockets, such as Docker Desktop's.
if [ -S /var/run/docker.sock ]; then
  DOCKER_SOCK_GID=$(stat -c %g /var/run/docker.sock)
  if [ "$DOCKER_SOCK_GID" != "0" ]; then
    sudo groupmod -o -g "$DOCKER_SOCK_GID" docker
  fi
fi
{% endif %}

NOCOLOR=$'\033[0m'
LOGO=$'\033[0;35m'
TEXT=$'\033[0;32m'
echo "${LOGO}"

echo " _____       _ _       _   _         ${TEXT}version: {{ version }}${LOGO}"
echo "|  __ \     | (_)     | | | |        ${TEXT}user: {{ user }}${LOGO}"
echo "| |  \/ ___ | |_  __ _| |_| |__      ${TEXT}home: /home/{{ user }}${LOGO}"
echo "| | __ / _ \| | |/ _  | __|  _ \     ${TEXT}ssh server: {{ install.ssh_server }} ip: $(hostname --all-ip-addresses | awk '{print $1}')${LOGO}"
echo "| |_\ \ (_) | | | (_| | |_| | | |    {% if install.atuin %}${TEXT}atuin: {{ atuin.server }}${LOGO}{% endif %}"
echo " \____/\___/|_|_|\__,_|\__|_| |_|    {% if install.atuin %}${TEXT}Run atuin login or atuin register to sync${LOGO}{% endif %}"
echo ' _____             _     _'
echo '|  _  |           | |   (_)'
echo '| | | |_ __ ______| |    _ _ __   ___'
echo '| | | |  _ \______| |   | |  _ \ / _ \'
echo '\ \_/ / | | |     | |___| | | | |  __/'
echo ' \___/|_| |_|     \_____/_|_| |_|\___|'
echo

echo " ${NOCOLOR}"
